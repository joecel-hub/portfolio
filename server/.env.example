# Copy to server/.env and fill in real values. Never commit server/.env.
# Loaded by the Express server from this directory (dotenv, server/env.js).

PORT=5175
DB_FILE=server/portfolio.db
UPLOAD_DIR=server/public/uploads

# Admin login (POST /api/auth/login)
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-string

# Git pushback persistence (free-tier Render). Leave unset to disable.
# GIT_PAT - GitHub fine-grained PAT with "Contents: Read and write" on the
#           repo below. Every CMS write is committed + pushed back to the repo,
#           so the next deploy carries the data. Each push triggers an
#           auto-deploy (that push is the persistence mechanism).
# GIT_PAT=github_pat_xxxxxxxxxxxxxxxxxxxx
# GIT_CMS_REMOTE=github.com/joecel-hub/portfolio
# GIT_CMS_BRANCH=main