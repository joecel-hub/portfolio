# Copy to server/.env and fill in real values. Never commit server/.env.
# Loaded by the Express server from this directory (dotenv, server/env.js).

PORT=5175
DB_FILE=server/portfolio.db
UPLOAD_DIR=server/public/uploads

# Admin login (POST /api/auth/login)
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-string